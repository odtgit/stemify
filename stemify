class Prof:
    """--profile: per-stage wall/CPU/epoch windows. Syncs CUDA at boundaries."""

    def __init__(self):
        import resource
        import torch
        self.rs, self.torch = resource, torch
        self.stages = {}
        self.stems = {}
        self.wins = {}
        self.lock = threading.Lock()
        self.peak = rss_mb()
        threading.Thread(target=self._sample, daemon=True).start()

    def _sample(self):
        while True:
            self.note(rss_mb())
            time.sleep(0.05)

    def note(self, r):
        with self.lock:
            self.peak = max(self.peak, r)
            for w in self.wins.values():
                w[0] = max(w[0], r)

    def sync(self):
        if self.torch.cuda.is_available():
            self.torch.cuda.synchronize()

    def mark(self, sync=True):
        if sync:
            self.sync()
        return (time.perf_counter(), time.process_time(),
                self.rs.getrusage(self.rs.RUSAGE_CHILDREN), time.time())

    @contextlib.contextmanager
    def stage(self, name, into=None, sync=True):
        a = self.mark(sync)
        win = [rss_mb()]
        with self.lock:
            self.wins[id(win)] = win
        try:
            yield
        finally:
            self.note(rss_mb())
            with self.lock:
                del self.wins[id(win)]
            b = self.mark(sync)
            ra, rb = a[2], b[2]
            child = (rb.ru_utime + rb.ru_stime) - (ra.ru_utime + ra.ru_stime)
            (self.stages if into is None else into)[name] = {
                "wall": round(b[0] - a[0], 4),
                "cpu": round(b[1] - a[1] + child, 4) if sync else None,
                "t0": round(a[3], 3), "t1": round(b[3], 3),
                "rss_peak_mb": round(win[0]), "rss_end_mb": round(rss_mb())}

    def hash_stems(self, arrs):
        for (label, _, _), a in zip(STEMS, arrs):
            a = np.ascontiguousarray(a, np.float32)
            rms = math.sqrt(energy(a) / a.size)
            self.stems[label.lower()] = {
                "sha256": hashlib.sha256(a.tobytes()).hexdigest(),
                "rms_db": round(20 * math.log10(max(rms, 1e-12)), 3)}

    def out(self):
        return {**self.stages, "stems": self.stems}

    def line(self):
        return " ".join(f"{k} {v['wall']:.1f}" for k, v in self.stages.items())


def rss_mb(key="VmRSS"):
    with open("/proc/self/status") as f:
        for line in f:
            if line.startswith(key + ":"):
                return int(line.split()[1]) / 1024
    return 0.0


AOT_REV = 1  # bump when aot_attach's graph split changes


def cache_root():
    return Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "stemify"


CUDA_WHEELS = (  # (nvidia/ subdir, pip name): build-time toolkit for the AOT build
    ("cuda_runtime", "nvidia-cuda-runtime-cu12"),  # cuda_runtime.h etc, libcudart.so.12
    ("cuda_nvcc", "nvidia-cuda-nvcc-cu12"),        # crt/ headers
    ("cuda_cccl", "nvidia-cuda-cccl-cu12"))        # cuda/, cub/, nv/ headers
CUDA_INSTALL_HINT = ("uv pip install nvidia-cuda-nvcc-cu12==12.8.93 "
                     "nvidia-cuda-cccl-cu12==12.8.90 nvidia-cuda-runtime-cu12==12.8.90")


def wheel_cuda_home():
    """Assemble (or reuse) a CUDA_HOME of symlinks into the venv's nvidia wheels
    under cache_root()/cudahome. Returns the path, or None if a wheel is missing
    (STEMIFY_NO_CUDA_WHEELS=1 simulates that)."""
    from importlib import metadata
    if os.environ.get("STEMIFY_NO_CUDA_WHEELS"):
        return None
    try:
        import nvidia
        roots = [Path(p) for p in nvidia.__path__]
        srcs = []
        for sub, pipname in CUDA_WHEELS:
            d = next((r / sub for r in roots if (r / sub / "include").is_dir()), None)
            if d is None:
                return None
            srcs.append((d, metadata.version(pipname)))
    except (ImportError, metadata.PackageNotFoundError):
        return None
    if not (srcs[0][0] / "lib" / "libcudart.so.12").exists():
        return None
    home = cache_root() / "cudahome"
    stamp = "\n".join(f"{d} {v}" for d, v in srcs)
    ok = home / ".stamp"
    if ok.exists() and ok.read_text() == stamp and not any(
            not l.exists() for l in home.rglob("*") if l.is_symlink()):
        return str(home)
    shutil.rmtree(home, ignore_errors=True)
    (home / "include").mkdir(parents=True)
    (home / "lib64").mkdir()
    for d, _ in srcs:  # first wheel wins on a name clash
        for e in sorted((d / "include").iterdir()):
            if e.name != "__init__.py" and not (home / "include" / e.name).exists():
                (home / "include" / e.name).symlink_to(e)
    (home / "lib64" / "libcudart.so").symlink_to(srcs[0][0] / "lib" / "libcudart.so.12")
    (home / "lib").symlink_to("lib64")
    ok.write_text(stamp)
    return str(home)


def toolkit():
    """CUDA_HOME for the AOT build: the user's, else the wheel-assembled one
    (exported to the env and torch.utils.cpp_extension). None if neither."""
    home = os.environ.get("CUDA_HOME")
    if not home:
        home = wheel_cuda_home()
        if home:
            import torch.utils.cpp_extension as ce
            os.environ["CUDA_HOME"] = ce.CUDA_HOME = home
    return home or None


def notice(msg):
    """Backend-selection notices: always stderr, so --json stdout stays pure events."""
    print(f"stemify: {msg}", file=sys.stderr, flush=True)


class Aoti:
    """Callable over an AOTIModelContainerRunnerCuda (what AOTICompiledModel wraps)."""

    def __init__(self, runner):
        import torch
        import torch.utils._pytree as pytree
        self.runner, self.torch, self.pt = runner, torch, pytree
        cs = runner.get_call_spec()
        self.in_spec, self.out_spec = pytree.treespec_loads(cs[0]), pytree.treespec_loads(cs[1])

    def __call__(self, *args):
        flat = [x for x in self.pt.tree_flatten((args, {}))[0] if isinstance(x, self.torch.Tensor)]
        return self.pt.tree_unflatten(self.runner.run(flat), self.out_spec)


def aot_load(pkg):
    """Load a .pt2 AOTInductor package from an extraction kept next to it.
    torch's aoti_load_package unpacks the zip (~0.7-0.9 GB of .so per model) into a
    hardcoded /tmp/XXXXXX on every call (TMPDIR is ignored), which is RAM on tmpfs.
    Instead extract once into <pkg>.x/ in the cache (reused by later runs, the
    old ones are removed when a package is rebuilt) and build the runner on the
    extracted .so; the .so is then mmapped from disk, not RAM. Falls back to
    aoti_load_package if that fails."""
    import torch
    import zipfile
    pkg = Path(pkg)
    x = pkg.with_name(pkg.stem + ".x")
    try:
        if not (x / ".ok").exists():
            tmp = pkg.with_name(pkg.stem + f".x.tmp{os.getpid()}")
            shutil.rmtree(tmp, ignore_errors=True)
            with zipfile.ZipFile(pkg) as z:
                z.extractall(tmp)
            (tmp / ".ok").touch()
            shutil.rmtree(x, ignore_errors=True)
            tmp.rename(x)
        mdir = next(x.glob("*/data/aotinductor/model"))
        so = next(mdir.glob("*.wrapper.so"))
        return Aoti(torch._C._aoti.AOTIModelContainerRunnerCuda(
            str(so), 1, "cuda", str(mdir)))
    except Exception as e:
        notice(f"{pkg.name}: direct load failed ({type(e).__name__}: {e}), using aoti_load_package (extracts to /tmp)")
        return torch._inductor.aoti_load_package(str(pkg))


def aot_attach(m, ckpt, say, force=False):
    """Swap the heavy middle of m's forward (band split, transformers, mask heads)
    for an AOTInductor package; STFT, complex mask apply and iSTFT stay eager.
    Package is built on first use into cache_root()/aot, keyed by torch, GPU,
    checkpoint size+mtime and chunk shape. Returns "build" or "load"; with
    force=False returns None (model untouched) if there is no package and no
    toolkit or the build fails; force=True exits/raises instead."""
    import torch
    import torch.nn as nn
    import torch.nn.functional as F
    from einops import pack, rearrange, unpack

    class Core(nn.Module):
        def __init__(s, net):
            super().__init__()
            s.band_split, s.layers, s.heads = net.band_split, net.layers, net.mask_estimators
            s.final_norm, s.skip = getattr(net, "final_norm", None), net.skip_connection

        def forward(s, x):
            x = s.band_split(x)
            store = [None] * len(s.layers)
            for i, blk in enumerate(s.layers):
                if len(blk) == 3:
                    lt, tt, ft = blk
                    x, ps = pack([x], "b * d")
                    x, = unpack(lt(x), ps, "b * d")
                else:
                    tt, ft = blk
                if s.skip:
                    for j in range(i):
                        x = x + store[j]
                x, ps = pack([rearrange(x, "b t f d -> b f t d")], "* t d")
                x, = unpack(tt(x), ps, "* t d")
                x, ps = pack([rearrange(x, "b f t d -> b t f d")], "* f d")
                x, = unpack(ft(x), ps, "* f d")
                if s.skip:
                    store[i] = x
            if s.final_norm is not None:
                x = s.final_norm(x)
            return torch.stack([h(x) for h in s.heads], dim=1)

    class Idx(nn.Module):
        def __init__(s, i):
            super().__init__()
            s.i = i

        def forward(s, x):
            return x[:, s.i]

    class Run(nn.Module):
        def __init__(s, r):
            super().__init__()
            s.r = r

        def forward(s, x):
            return s.r(x)

    net = m._model.eval().requires_grad_(False)
    for mod in net.modules():  # explicit fp16 sdpa: export drops autocast's cast here
        if hasattr(mod, "flash_attn"):
            mod.flash_attn = lambda q, k, v: F.scaled_dot_product_attention(
                q.half(), k.half(), v.half())
    shape = []
    h = net.band_split.register_forward_pre_hook(lambda mod, a: shape.append(tuple(a[0].shape)))
    sep(m, np.zeros((m._config.audio.chunk_size, 2), np.float32))  # eager: fills rotary caches
    h.remove()
    ckpt = Path(ckpt)
    st = ckpt.stat()
    key = hashlib.sha1("|".join(map(str, (
        AOT_REV, torch.__version__, torch.cuda.get_device_name(), st.st_size, st.st_mtime_ns,
        shape[0]))).encode()).hexdigest()[:16]
    d = cache_root() / "aot"
    pkg = d / f"{ckpt.stem}-{key}.pt2"
    core = Core(net)
    how = "load"
    if not pkg.exists():
        how = "build"
        if not toolkit():
            msg = ("first AOT build needs a CUDA toolkit: install the version-matched wheels "
                   f"({CUDA_INSTALL_HINT}) or set CUDA_HOME")
            if force:
                sys.exit(f"--aot: {msg}")
            notice(f"{ckpt.name}: running eager, {msg}")
            return None
        say(f"aot: building {pkg.name} (one-off) ...")
        d.mkdir(parents=True, exist_ok=True)
        tmp = pkg.with_suffix(".tmp.pt2")
        try:
            with torch.autocast("cuda"), torch.inference_mode():
                ep = torch.export.export(core, (torch.zeros(shape[0], device="cuda"),),
                                         strict=False)
                torch._inductor.aoti_compile_and_package(ep, package_path=str(tmp))
        except Exception as e:
            if force:
                raise
            notice(f"{ckpt.name}: AOT build failed ({type(e).__name__}), running eager")
            return None
        tmp.rename(pkg)
        for old in d.glob(f"{ckpt.stem}-*.pt2"):
            if old != pkg:
                old.unlink()
        for old in d.glob(f"{ckpt.stem}-*.x*"):
            shutil.rmtree(old, ignore_errors=True)
    n = len(net.mask_estimators)
    net.band_split, net.layers = None, nn.ModuleList()
    if hasattr(net, "final_norm"):
        net.final_norm = nn.Identity()
    net.mask_estimators = nn.ModuleList([Idx(i) for i in range(n)])
    net.band_split = Run(aot_load(pkg))
    del core
    torch.cuda.empty_cache()
    return how


def probe_rate(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "a:0",
         "-show_entries", "stream=sample_rate", "-of", "csv=p=0", str(path)],
        capture_output=True, text=True, check=True).stdout.strip()
    return int(out.splitlines()[0])


def decode(src):
    """Float32 stereo 44.1k (n, 2) straight from ffmpeg, no temp file."""
    raw = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", str(src), "-vn", "-map", "0:a:0",
         "-ar", str(RATE), "-ac", "2", "-f", "f32le", "-"],
        check=True, stdout=subprocess.PIPE).stdout
    return np.frombuffer(raw, np.float32).reshape(-1, 2)


def energy(x, step=1 << 21):
    """Sum of squares in float64, converted chunk by chunk (no full-size copy)."""
    x = x.ravel()
    t = 0.0
    for i in range(0, len(x), step):
        c = x[i:i + step].astype(np.float64)
        t += float(np.dot(c, c))
    return t


def sep(model, x, keep=None):
    """x: (n, 2) float -> {stem: (n, 2) float32}. MSST chunks with the YAML
    chunk_size/num_overlap and runs in float, no peak normalisation. Only the
    stems in keep (default all) are copied out; MSST's own outputs are freed."""
    with contextlib.redirect_stdout(sys.stderr):
        out = model.separate(np.ascontiguousarray(x.T))
    n = len(x)
    res = {}
    for k in list(out):
        v = out.pop(k)
        if keep is None or k in keep:
            res[k] = np.ascontiguousarray(v.T[:n])
        del v
    return res


def separate_ft2sw(models, src, prof=None):
    """Return (stems in NI order, mix length, other-extra dB)."""
    m_v, m_sw = models
    S = prof.stage if prof else (lambda n: contextlib.nullcontext())
    with S("decode"):
        mix = decode(src)
    nframes = len(mix)
    with S("vocal_pass"):
        v = sep(m_v, mix, {"vocals"})["vocals"]
    with S("inst"):
        inst = mix - v
        del mix
    with S("sw_pass"):
        st = sep(m_sw, inst, {"drums", "bass", "other", "guitar", "piano"})
    with S("residual"):
        d, b = st.pop("drums"), st.pop("bass")
        o = inst - d
        o -= b
        del inst
        # Energy in O that SW itself did not call other/guitar/piano.
        eo = energy(o)
        sw_o = st.pop("other")
        sw_o += st.pop("guitar")
        sw_o += st.pop("piano")
        del st
        extra = 0.0
        for i in range(0, len(o), 1 << 20):
            extra += energy(o[i:i + (1 << 20)] - sw_o[i:i + (1 << 20)])
        del sw_o
        extra_db = (10 * math.log10(max(extra, 1e-30) / eo)
                    if eo > 0 else float("nan"))
    if prof:
        prof.hash_stems([d, b, o, v])
    return [d, b, o, v], nframes, extra_db


def mux(src, stems, dest, rate, bitrate):
    """Mux master + 4 stems into a 5-stream m4a. moov lands last, which the
    atom injection below depends on."""
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-i", str(src)]
    for s in stems:
        cmd += ["-i", str(s)]
    for i in range(5):
        cmd += ["-map", f"{i}:a:0"]
    # No +use_metadata_tags: that stores tags as QuickTime mdta keys, which
    # ffprobe reads but TagLib does not — Mixxx then shows an empty artist
    # (single-dash filenames only *looked* tagged via Mixxx's filename guess).
    # Default ilst mapping covers artist/title/album/date; ISRC is dropped,
    # the source FLAC keeps it.
    cmd += ["-c:a", "aac", "-b:a", bitrate, "-ar", str(rate), "-ac", "2",
            "-map_metadata", "0",
            "-f", "mp4", str(dest)]
    subprocess.run(cmd, check=True)


def embed_cover(dest, src):
    """Copy the source's embedded art into the iTunes covr atom.

    ffmpeg cannot do this in the mux: FLAC/MP3 art is an attached-pic *stream*
    to it, and the output must stay exactly 5 audio streams for Mixxx. Runs
    before inject_manifest so mutagen's moov rewrite cannot disturb the stem
    atom (and moov stays last, which injection asserts).
    """
    from mutagen import File as MFile
    from mutagen.mp4 import MP4, MP4Cover

    m = MFile(str(src))
    data = mime = None
    if getattr(m, "pictures", None):                     # FLAC
        data, mime = m.pictures[0].data, m.pictures[0].mime
    elif m is not None and m.tags:                       # MP3 APIC
        apic = [v for k, v in m.tags.items() if k.startswith("APIC")]
        if apic:
            data, mime = apic[0].data, apic[0].mime
    if not data:
        return False
    fmt = MP4Cover.FORMAT_PNG if "png" in (mime or "") else MP4Cover.FORMAT_JPEG
    mp4 = MP4(str(dest))
    mp4["covr"] = [MP4Cover(data, imageformat=fmt)]
    mp4.save()
    return True


def stem_manifest():
    return {
        "mastering_dsp": MANIFEST_DSP,
        "version": 1,
        "stems": [{"color": c, "name": nm} for _, c, nm in STEMS],
    }


def iter_boxes(buf, start, end):
    """Yield (offset, size, type) for each MP4 box in [start, end)."""
    pos = start
    while pos + 8 <= end:
        size, btype = struct.unpack(">I4s", buf[pos:pos + 8])
        if size == 1:  # 64-bit extended size
            size = struct.unpack(">Q", buf[pos + 8:pos + 16])[0]
        elif size == 0:  # extends to EOF
            size = end - pos
        if size < 8:
            raise ValueError(f"corrupt box at {pos}")
        yield pos, size, btype.decode("latin-1")
        pos += size


def inject_manifest(path, manifest):
    """Append moov.udta.stem. Safe only because ffmpeg wrote moov last, so
    growing it cannot shift mdat and invalidate the stco chunk offsets."""
    buf = bytearray(Path(path).read_bytes())

    top = list(iter_boxes(buf, 0, len(buf)))
    moov = next((b for b in top if b[2] == "moov"), None)
    if moov is None:
        raise RuntimeError("no moov box found")
    if moov is not top[-1]:
        raise RuntimeError("moov is not the last box; refusing to corrupt offsets")

    moov_off, moov_size, _ = moov
    payload = json.dumps(manifest, separators=(",", ":")).encode("utf-8")
    stem_box = struct.pack(">I4s", 8 + len(payload), b"stem") + payload

    udta = next((b for b in iter_boxes(buf, moov_off + 8, moov_off + moov_size)
                 if b[2] == "udta"), None)

    if udta is None:
        new = struct.pack(">I4s", 8 + len(stem_box), b"udta") + stem_box
        buf[moov_off + moov_size:moov_off + moov_size] = new
        grow = len(new)
    else:
        u_off, u_size, _ = udta
        buf[u_off + u_size:u_off + u_size] = stem_box
        grow = len(stem_box)
        struct.pack_into(">I", buf, u_off, u_size + grow)

    struct.pack_into(">I", buf, moov_off, moov_size + grow)
    Path(path).write_bytes(bytes(buf))


def verify(path):
    """Confirm the result is actually loadable as a stem file."""
    n = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "a",
         "-show_entries", "stream=index", "-of", "csv=p=0", str(path)],
        capture_output=True, text=True, check=True).stdout.split()
    buf = Path(path).read_bytes()
    moov = next(b for b in iter_boxes(bytearray(buf), 0, len(buf)) if b[2] == "moov")
    has_atom = any(
        b[2] == "stem"
        for u in iter_boxes(bytearray(buf), moov[0] + 8, moov[0] + moov[1])
        if u[2] == "udta"
        for b in iter_boxes(bytearray(buf), u[0] + 8, u[0] + u[1])
    )
    return len(n), has_atom


def art_only(args):
    """Swap art in finished stems without touching the audio.

    Fix the art in the source file first — it stays the source of truth, and
    the next full render would otherwise put the old cover straight back.
    embed_cover rewrites moov, so the stem atom is re-checked afterwards and
    re-injected if the rewrite lost it (not observed with mutagen, but the
    repair is one call and the alternative is a silent fall back to
    extension-only stem detection in Mixxx).
    """
    failures = 0
    for t in args.tracks:
        dest = args.output_dir / (t.stem + ".stem.mp4")
        if not t.is_file():
            print(f"skip (not a file): {t}", file=sys.stderr)
            failures += 1
            continue
        if not dest.is_file():
            print(f"skip (no stem to update): {dest.name}", file=sys.stderr)
            failures += 1
            continue
        if not embed_cover(dest, t):
            print(f"    !! no embedded art in {t.name}", file=sys.stderr)
            failures += 1
            continue
        streams, atom = verify(dest)
        if not atom:
            try:
                inject_manifest(dest, stem_manifest())
                streams, atom = verify(dest)
            except RuntimeError as e:
                print(f"    !! {dest.name}: manifest lost and not re-injectable "
                      f"({e}) — re-render with --force", file=sys.stderr)
        if streams != 5 or not atom:
            failures += 1
            continue
        print(f"    -> {dest.name}  (art refreshed, {streams} streams, "
              f"manifest ok)", flush=True)
    print(f"\ndone: {len(args.tracks) - failures}/{len(args.tracks)} succeeded")
    return 1 if failures else 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("tracks", nargs="+", type=Path)
    ap.add_argument("-o", "--output-dir", type=Path, default=Path.cwd())
    ap.add_argument("-m", "--model", default=DEFAULT_MODEL,
                    help="only ft2sw is supported under MSST")
    ap.add_argument("-b", "--bitrate", default="256k")
    ap.add_argument("--vocal-overlap", type=int, default=VOCAL_OVERLAP,
                    help="chunk overlap count for the vocal model. 2 = 50%%: 32.6 dB "
                         "from the YAML default 8 at 1/4.4 the time, no 8 s seams "
                         "(measured 2026-10-02)")
    ap.add_argument("--keep-stems", action="store_true",
                    help="also keep the raw separated wavs")
    ap.add_argument("--force", action="store_true",
                    help="re-render even if the .stem.mp4 already exists")
    ap.add_argument("--art-only", action="store_true",
                    help="refresh the covr atom in the existing .stem.mp4 from "
                         "the source's embedded art; no separation, no re-encode")
    ap.add_argument("--profile", action="store_true",
                    help="per-stage wall/CPU timing, stem hashes and RMS (see README)")
    ap.add_argument("--fp32", action="store_true",
                    help="disable autocast (fp16) in both models, for comparison; implies "
                         "--eager unless --compile is given")
    ap.add_argument("--compile", action="store_true",
                    help="torch.compile both models. Pays a warm-up once per "
                         "invocation; stems differ slightly from the eager path")
    ap.add_argument("--aot", action="store_true",
                    help="force the AOTInductor backend (the default when possible): error "
                         "instead of falling back if the package cannot be built or loaded")
    ap.add_argument("--eager", action="store_true",
                    help="plain eager PyTorch, no AOT package, no compile")
    ap.add_argument("--compile-mode", default="default",
                    choices=["default", "reduce-overhead", "max-autotune"])
    ap.add_argument("--json", action="store_true",
                    help="one JSON event per stdout line instead of human lines")
    args = ap.parse_args()
    if sum((args.aot, args.compile, args.eager)) > 1:
        ap.error("--aot, --compile and --eager are mutually exclusive")
    if args.aot and args.fp32:
        ap.error("--aot excludes --fp32")
    if args.fp32 and not args.compile:
        args.eager = True
    # default: AOT if a package exists or can be built, else eager (with a notice on stderr)
    use_aot = args.aot or not (args.compile or args.eager)

    if args.model != DEFAULT_MODEL:
        ap.error(f"only -m {DEFAULT_MODEL} is supported (legacy htdemucs_ft path dropped)")

    args.output_dir.mkdir(parents=True, exist_ok=True)

    if args.art_only:
        return art_only(args)

    def say(msg="", **kw):
        if not args.json:
            print(msg, flush=True, **kw)

    def event(**kw):
        if args.json:
            print(json.dumps(kw), flush=True)

    todo = []
    for t in args.tracks:
        if not t.is_file():
            print(f"skip (not a file): {t}", file=sys.stderr)
            continue
        dest = args.output_dir / (t.stem + ".stem.mp4")
        if dest.exists() and not args.force:
            say(f"skip (exists): {dest.name}")
            continue
        todo.append((t, dest))

    if not todo:
        say("nothing to do")
        event(event="start", n=0)
        event(event="done", ok=0, failed=0)
        return 0

    os.environ.setdefault("TQDM_DISABLE", "1")

    if args.compile or use_aot:  # persistent compile caches; must precede torch import
        cache = cache_root()
        os.environ.setdefault("TORCHINDUCTOR_CACHE_DIR", str(cache / "inductor"))
        os.environ.setdefault("TRITON_CACHE_DIR", str(cache / "triton"))

    # Import late so --help stays instant; loading torch takes seconds.
    from msst import Separator
    prof = None
    if args.profile:
        prof = Prof()
        prof.sync()
        startup = {"wall": round(time.perf_counter() - P0, 4),
                   "cpu": round(time.process_time(), 4),
                   "t0": round(T0, 3), "t1": round(time.time(), 3)}

    model_dir = Path(os.environ.get("STEMIFY_MODEL_DIR",
                                    os.environ.get("AUDIO_SEPARATOR_MODEL_DIR",
                                                   Path(__file__).parent / "models")))
    work = Path(tempfile.mkdtemp(prefix="stemify-", dir=args.output_dir))

    def load(spec):
        mtype, cfg, ckpt = spec
        say(f"loading {ckpt} ...")
        with contextlib.redirect_stdout(sys.stderr):
            return Separator(config_path=model_dir / cfg, checkpoint_path=model_dir / ckpt,
                             model_type=mtype, detailed_progress=False)

    ml = {}
    with (prof.stage("model_load", ml) if prof else contextlib.nullcontext()):
        models = (load(VOCAL_MODEL), load(SW_MODEL))
    models[0]._config.inference.num_overlap = args.vocal_overlap  # SW keeps its YAML value
    if args.fp32:
        for m in models:
            m._config.training.use_amp = False
            # fp32 has no flash kernel; the models' flash-only config would abort
            for mod in m._model.modules():
                cfg = getattr(mod, "cuda_config", None)
                if cfg is not None:
                    mod.cuda_config = type(cfg)(False, True, True)
    cp = {}
    if use_aot:
        say("aot ...")
        with (prof.stage("compile", cp) if prof else contextlib.nullcontext()):
            for m, spec in zip(models, (VOCAL_MODEL, SW_MODEL)):
                how = aot_attach(m, model_dir / spec[2], say, force=args.aot)
                say(f"aot: {how or 'eager'} {spec[2]}")
                sep(m, np.zeros((m._config.audio.chunk_size, 2), np.float32))
    if args.compile:
        say(f"compiling ({args.compile_mode}) ...")
        with (prof.stage("compile", cp) if prof else contextlib.nullcontext()):
            for m in models:
                m._model.compile(mode=args.compile_mode)
                # one silent chunk: same shapes and autocast path as real demix
                sep(m, np.zeros((m._config.audio.chunk_size, 2), np.float32))
    if prof:
        event(event="profile_process", startup=startup, model_load=ml["model_load"],
              fp32=args.fp32, compile=args.compile_mode if args.compile else None,
              **({"warmup": cp["compile"]} if cp else {}))
        say(f"profile: startup {startup['wall']:.1f}s, model_load "
            f"{ml['model_load']['wall']:.1f}s")

    event(event="start", n=len(todo))
    failures = 0
    lock = threading.Lock()

    def emit(human, ev, err=False):
        # sep() swaps sys.stdout to stderr from the main thread; the worker must not follow it
        with lock:
            if human is not None and not args.json:
                print(human, file=sys.stderr if err else sys.__stdout__, flush=True)
            if ev and args.json:
                print(json.dumps(ev), file=sys.__stdout__, flush=True)

    def post(n, src, dest, arrs, nframes, extra_db, t0, pst, overlapped):
        """write_wavs + mux + finalize. Runs in the worker when the batch has
        >1 track, so no CUDA sync here (it would stall on the next track's GPU work)."""
        wd = work / str(n)
        P = ((lambda k: prof.stage(k, pst, sync=False)) if prof
             else (lambda k: contextlib.nullcontext()))
        pa = time.perf_counter(), time.time()
        try:
            wd.mkdir()
            stems = []
            with P("write_wavs"):
                for (label, _, _), a in zip(STEMS, arrs):
                    p = wd / f"{label.lower()}.wav"
                    sf.write(str(p), a, RATE, subtype="FLOAT")
                    stems.append(p)
                    del a
                    arrs[len(stems) - 1] = None  # free each stem once written
            with P("mux"):
                mux(src, stems, dest, probe_rate(src), args.bitrate)
            with P("finalize"):
                art = embed_cover(dest, src)
                inject_manifest(dest, stem_manifest())
                streams, atom = verify(dest)
                if streams != 5 or not atom:
                    raise RuntimeError(f"bad output: {streams} streams, atom={atom}")
            if args.keep_stems:
                keep = args.output_dir / f"{src.stem}.stems"
                keep.mkdir(exist_ok=True)
                for p, (label, _, _) in zip(stems, STEMS):
                    shutil.move(str(p), keep / f"{label.lower()}{p.suffix}")
            secs = time.monotonic() - t0
            audio_secs = nframes / RATE
            warnings = [] if art else [f"no embedded art in {src.name}"]
            human = (f"    -> {dest.name}  (5 streams, manifest ok, "
                     f"art {'ok' if art else 'MISSING in source'}, other-extra "
                     f"{extra_db:+.1f} dB, {secs:.0f}s for {audio_secs:.0f}s audio)")
            extra = {}
            if prof:
                pst["post_overlap"] = {"wall": round(time.perf_counter() - pa[0], 4),
                               "t0": round(pa[1], 3), "t1": round(time.time(), 3),
                               "overlapped": overlapped}
                human += "\n    profile: " + " ".join(
                    f"{k} {v['wall']:.1f}" for k, v in pst.items() if k != "stems")
                extra["profile"] = pst
            emit(human, dict(
                event="track_done", i=n, src=str(src), dest=str(dest),
                secs=round(secs, 2), audio_secs=round(audio_secs, 2),
                other_extra_db=None if math.isnan(extra_db) else round(extra_db, 2),
                warnings=warnings, **extra))
            return True
        except Exception as e:
            dest.unlink(missing_ok=True)
            emit(f"    !! failed: {e}", dict(event="track_failed", i=n, src=str(src),
                                             error=str(e)), err=True)
            return False
        finally:
            shutil.rmtree(wd, ignore_errors=True)

    # One worker, at most one track pending: bounds memory to two tracks' arrays.
    ex = ThreadPoolExecutor(1) if len(todo) > 1 else None
    pending = None

    def drain():
        nonlocal pending, failures
        if pending is not None:
            failures += not pending.result()
            pending = None

    tb = time.monotonic()
    for n, (src, dest) in enumerate(todo, 1):
        emit(f"[{n}/{len(todo)}] {src.name}", dict(event="track_start", i=n, src=str(src)))
        t0 = time.monotonic()
        if prof:
            prof.stages, prof.stems = {}, {}
        try:
            arrs, nframes, extra_db = separate_ft2sw(models, src, prof)
            arrs = list(arrs)
        except Exception as e:
            drain()  # keep events in track order
            failures += 1
            emit(f"    !! failed: {e}", dict(event="track_failed", i=n, src=str(src),
                                             error=str(e)), err=True)
            dest.unlink(missing_ok=True)
            continue
        drain()
        pst = {**prof.out()} if prof else None
        job = (n, src, dest, arrs, nframes, extra_db, t0, pst, n < len(todo))
        del arrs
        if ex:
            pending = ex.submit(post, *job)
        else:
            failures += not post(*job)
        del job
    drain()
    if ex:
        ex.shutdown()
    batch_wall = time.monotonic() - tb

    shutil.rmtree(work, ignore_errors=True)
    say(f"\ndone: {len(todo) - failures}/{len(todo)} succeeded")
    event(event="done", ok=len(todo) - failures, failed=failures,
          **({"batch_wall": round(batch_wall, 2), "rss_peak_mb": round(rss_mb("VmHWM"))}
             if prof else {}))
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
